# Production environment: copy to backend/.env (ignored by git) and fill in.
# docker compose reads backend/.env by itself and hands the values to the containers (compose.yaml).
#
# Plain KEY=value lines: no quotes, no spaces in a value, no comments after a value, and no `$` in values (compose
# would expand it).
# Commented-out variables are optional; the value shown is the default.

# --- PostgreSQL (compose + application) ---
# Required
POSTGRES_USER=workshop_manager
# Required
POSTGRES_PASSWORD=change-me

# --- Redis (compose + application) ---
# Required
REDIS_PASSWORD=change-me

# --- SeaweedFS / S3 storage (compose + application) ---
# Required: without credentials SeaweedFS accepts unsigned requests from anyone
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Application ---
# Required. Base64 key for JWT signing and signed download links: head -c 48 /dev/urandom | base64 -w0
JWT_SECRET_KEY=change-me
# Required. Public address users open (no path), also the Steam OpenID realm: Steam sign-in only works with the
# real address. Redirects and links are built from it, so the application does not start without it
FRONTEND_URL=https://workshop.example.com
# Required. Image of the application: a tag pushed by the CI, or any name to build it here (docker compose build app)
APP_IMAGE=ghcr.io/owner/workshop-manager:1.0.0

# --- First administrator: created on startup only while there are no users ---
# Needed on the first start, otherwise nobody can sign in: username + password, a Steam ID, or both.
# Can be removed once the account exists.
# Sign-in username, e.g. admin
#BOOTSTRAP_ADMIN_USERNAME=
# 8-128 characters with upper and lower case, a digit and a special character
#BOOTSTRAP_ADMIN_PASSWORD=
# SteamID64 (17 digits) for Steam sign-in
#BOOTSTRAP_ADMIN_STEAM_ID=

# --- Steam (optional) ---
# Unlisted items, dependencies, votes and author names
#STEAM_WEB_API_KEY=

# --- Monitoring (compose) ---
# Required. Grafana's admin password
GRAFANA_ADMIN_PASSWORD=change-me

# --- nginx (compose) ---
# Required. Folder with fullchain.pem and privkey.pem (copies, not certbot's live/ symlinks)
TLS_CERT_DIR=/etc/workshop-manager/certs
