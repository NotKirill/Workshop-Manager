      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_client_requests_seconds_count[$__rate_interval])) * 60",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Call time p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
