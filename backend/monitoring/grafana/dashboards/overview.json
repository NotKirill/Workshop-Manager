      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, client_name) (rate(http_client_requests_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{client_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (client_name) (rate(http_client_requests_seconds_sum[$__rate_interval])) / sum by (client_name) (rate(http_client_requests_seconds_count[$__rate_interval]))",
          "legendFormat": "{{client_name}} avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breakers (1 = open) and retries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (name) (resilience4j_circuitbreaker_state{state=~\"open|forced_open\"})",
          "legendFormat": "{{name}} open"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (name, kind) (increase(resilience4j_retry_calls_total{kind=~\".*with_retry\"}[$__rate_interval]))",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
